# Copy to .env.local and fill in. On Vercel, set these in Project Settings > Environment Variables.

# --- Recall.ai (required) ---------------------------------------------------
# Region your Recall account lives in: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2
# Dashboard > Developers > API Keys (https://us-west-2.recall.ai/dashboard/developers/api-keys)
RECALL_API_KEY=
# Dashboard > Developers > API Keys & Secrets > Workspace Verification Secret (starts with whsec_)
RECALL_WEBHOOK_SECRET=

# --- Database (required) ----------------------------------------------------
# Any Postgres URL. The Vercel Neon integration sets this for you.
DATABASE_URL=

# --- Public URL (local development only) ------------------------------------
# Recall must reach your app over the internet. Locally, put your ngrok domain here
# (no trailing slash). On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# --- LLM (optional) ---------------------------------------------------------
# Without any of these the app still works; summaries fall back to a rule-based version.
# Option A: Vercel AI Gateway. Automatic on Vercel (OIDC). Locally run `vercel env pull`
#           or set AI_GATEWAY_API_KEY.
# Option B: OPENAI_API_KEY to call OpenAI directly.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Model id. Gateway format "provider/model"; with OPENAI_API_KEY just the model name is used.
AI_MODEL=openai/gpt-5-mini
